[Unit]
Description=Votacao - App Web (eleitor)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/votacao/web
EnvironmentFile=/opt/votacao/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
User=votacao
StandardOutput=append:/var/log/votacao/web.log
StandardError=append:/var/log/votacao/web.log
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/votacao

[Install]
WantedBy=multi-user.target
