# Na AWS este arquivo é gerado automaticamente em /opt/votacao/.env pelo deploy/bootstrap-ec2.sh
# (segredos vindos do SSM Parameter Store). Para rodar localmente, copie para .env:
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://votacao_web:senha@localhost:5432/votacao
COOKIE_SECURE=false
SESSION_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_EMAILS=
