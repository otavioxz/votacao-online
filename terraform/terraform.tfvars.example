# Copie para terraform.tfvars e preencha (terraform.tfvars está no .gitignore).

region  = "us-east-2"
project = "votacao"

# IP público da instituição (e o seu, para a apresentação). Descubra em https://checkip.amazonaws.com
admin_allowed_cidrs = ["200.100.50.10/32"]

# Comissão eleitoral (login por código enviado a esses e-mails)
admin_emails = ["seu.email@unidavi.edu.br"]

# Recebe os alarmes do CloudWatch
alert_email = "seu.email@unidavi.edu.br"

# E-mail pelo Amazon SES: o Terraform cria a credencial SMTP. A AWS manda um link de
# verificação para o remetente e para cada e-mail da comissão (clique antes de usar).
email_via_ses = true
# ses_from_email = "votacao@unidavi.edu.br" # padrão: o primeiro de admin_emails
# Conta no sandbox do SES só envia para e-mails verificados: inclua os eleitores de teste
ses_verified_emails = []

# Sem SES (AWS Academy): email_via_ses = false e um SMTP externo, ex.: Gmail com "senha de app"
# smtp_host     = "smtp.gmail.com"
# smtp_port     = 587
# smtp_user     = "sua.conta@gmail.com"
# smtp_password = "xxxx xxxx xxxx xxxx"

# Branch clonada no 1º boot das EC2 (use o nome desta branch para testar antes do merge)
git_ref = "main"

# Conta AWS própria: o Terraform cria a role das EC2. No AWS Academy use false (usa o LabInstanceProfile).
create_instance_role = true

# Se o AWS Academy negar a criação da trilha, troque para false
enable_cloudtrail = true
